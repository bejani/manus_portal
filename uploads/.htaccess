Options -Indexes

# جلوگیری از اجرای اسکریپت‌های آپلودشده
<FilesMatch "\.(php|phtml|php[0-9]?|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

# جلوگیری از تفسیر فایل‌های مشکوک به‌عنوان کد
AddType text/plain .php .phtml .phar .cgi .pl .py .sh

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
